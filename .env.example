# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored and must never be committed.

# Supabase (free tier) — create a project at https://supabase.com/dashboard
# Project Settings > API: URL + anon public key (safe to expose in the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Absolute public site URL. Used for OG/metadata. Local dev default:
NEXT_PUBLIC_SITE_URL=http://localhost:3000